# Django Production Settings
SECRET_KEY=replace-this-with-a-real-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_SERVER_IP,localhost,127.0.0.1

# Database Configuration (Optional: SQLite used by default if DATABASE_URL is empty)
DATABASE_URL=postgres://royal_user:royal_password@db:5432/royal_barber_db

# Security & CORS (Optional)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
